# CodeHaunt environment. Copy to .env (gitignored) and fill in. Every key is documented here.
# Apps exit at startup with the key name if a required value is missing or invalid.

# --- Database (Postgres 16, docker-compose service `postgres`, 127.0.0.1 only) ---
POSTGRES_USER=codehaunt
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=codehaunt
# Host port. 5434 avoids other Postgres instances on the same machine.
POSTGRES_PORT=5434
# Must match the four values above. Owner credentials: migrations, seed and tests only.
DATABASE_URL=postgresql://codehaunt:CHANGE_ME@127.0.0.1:5434/codehaunt
# Passwords of codehaunt_web and codehaunt_worker, the non-superuser roles web and worker connect as
# (created by `migrate`; must differ). Generate each: openssl rand -hex 16
WEB_DB_PASSWORD=
WORKER_DB_PASSWORD=

# --- Web ---
# Leave unset: Secure cookies in production. Set COOKIE_SECURE=false only for plain-HTTP localhost/LAN dev.
# COOKIE_SECURE=false

# --- Worker / sandbox ---
# C runner image; the others are derived as codehaunt-runner-{cpp,java,python}:1. Build: make runners
RUNNER_IMAGE=codehaunt-runner:1
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3101
# GID of the host's docker group (getent group docker | cut -d: -f3); lets docker-proxy (only it) use the socket.
DOCKER_GID=999
# Host port for the web container (docker compose --profile core).
WEB_PORT=3100

# --- Inference gateway (GPU cluster, deploy/gpu-cluster/) ---
# Base URLs via Tailscale Serve on gpu-master (→ Traefik); the web API appends /v1/chat/completions, uses gateway-a and
# retries gateway-b only if gateway-a is unreachable or not ready.
GATEWAY_URL=https://gpu-master.taila67919.ts.net/codehaunt-gateway-a
GATEWAY_FALLBACK_URL=https://gpu-master.taila67919.ts.net/codehaunt-gateway-b
# Same value as the k8s Secret codehaunt/gateway-token (openssl rand -hex 32). Only the DGX holds it.
GATEWAY_TOKEN=

# --- Dev seed only (make seed). Unset: a random password is generated and printed once. ---
SEED_PASSWORD=

# --- Filled in by the event owner. Until these are set, everything runs on localhost only. ---

# Cloudflare API token that keeps the staff Access group in sync (scoped to Access groups only).
#  1. dash.cloudflare.com → My Profile → API Tokens → Create Token → Custom token → Get started.
#  2. Permissions: Account · "Access: Organizations, Identity Providers, and Groups" · Edit. Add nothing else.
#  3. Account Resources: Include · <the account that owns the CodeHaunt domain>.
#  4. Optional: Client IP Address Filtering = the server's public IP; TTL = after the event.
#  5. Continue to summary → Create Token → copy it here (it is shown once).
CLOUDFLARE_API_TOKEN=
# Account ID: dashboard home → the account → the "Account ID" field (right-hand column, or the URL after dash.cloudflare.com/).
CLOUDFLARE_ACCOUNT_ID=
# Tunnel for this deployment:
#  1. Zero Trust dashboard (one.dash.cloudflare.com) → Networks → Tunnels → Create a tunnel → Cloudflared.
#  2. Name it (e.g. codehaunt), save; copy the Tunnel ID shown in the tunnel list into CLOUDFLARE_TUNNEL_ID.
#  3. The install command on that page contains the token (the long string after `--token`); copy it into
#     CLOUDFLARE_TUNNEL_TOKEN. Never pass it on a command line: it would be visible in `ps`.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# Safe Exam Browser Config Key (64 hex characters), used to verify X-SafeExamBrowser-ConfigKeyHash server-side.
#  1. Windows: Start → "SEB Configuration Tool"; open the CodeHaunt .seb file.
#  2. Exam tab → tick "Use Browser Exam Key and Config Key (send in HTTP header)" (wording varies by SEB version;
#     the settings key is sendBrowserExamKey).
#  3. The Config Key is shown on the same tab. Copy it here, then save the .seb file. Any later settings change
#     changes the key: copy it again.
SEB_CONFIG_KEY=
