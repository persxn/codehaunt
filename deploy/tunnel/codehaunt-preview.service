[Unit]
Description=CodeHaunt — public landing preview (next start on 127.0.0.1:3200; tunnel allows only / and its assets)
After=network-online.target

[Service]
WorkingDirectory=%h/Desktop/codehaunt/apps/web
EnvironmentFile=%h/.config/codehaunt-preview.env
Environment=PATH=/home/uem/.nvm/versions/node/v22.23.2/bin:/usr/bin:/bin
ExecStart=/home/uem/.nvm/versions/node/v22.23.2/bin/node %h/Desktop/codehaunt/node_modules/next/dist/bin/next start -p 3200 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
