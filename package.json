{
  "name": "codehaunt",
  "private": true,
  "version": "0.1.0",
  "description": "Harness for AI-assisted coding contests: participants solve problems by prompting a small code model under a token budget",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check-readmes": "node scripts/check-readmes.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
