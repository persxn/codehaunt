// CodeHaunt core schema. Every participant, prompt, submission and score belongs to one Event.
// Event-specific settings live in Event.config, validated by EventConfig in @codehaunt/contracts.
// Append-only tables (audit_log, token_ledger) are protected by triggers in the first migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// Prisma 7 takes the connection URL from prisma.config.ts (migrations) and from the
// driver adapter at runtime (src/client.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts and sessions
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ORGANIZER
  VOLUNTEER
  PARTICIPANT
}

model User {
  id           String    @id @default(cuid())
  /// Lower-case login handle. Participants use their enrolment number.
  username     String    @unique
  name         String
  email        String?   @unique
  role         Role
  passwordHash String
  /// Participants stay inactive until their QR is scanned at check-in (ADR-013).
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions     AuthSession[]
  participants Participant[]
  auditEntries AuditLog[]    @relation("AuditActor")

  @@map("users")
}

/// Login session. `id` is the SHA-256 of the cookie token; the token itself is never stored.
model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// Event, problems, tests
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  CHECK_IN
  RUNNING
  PAUSED
  ENDED
  JUDGING
  PUBLISHED
}

/// Results after the contest (ADR-009): provisional → appeal window → final.
enum ResultsState {
  NONE
  PROVISIONAL
  FINAL
}

model Event {
  id                 String       @id @default(cuid())
  slug               String       @unique
  name               String
  status             EventStatus  @default(DRAFT)
  /// EventConfig (zod, @codehaunt/contracts): schedule, budgets, languages, weights, model, rubric.
  config             Json
  /// Set when the contest starts; problems and scoring weights are frozen from then on (ADR-006). Also the actual
  /// start of the contest clock (ADR-028).
  lockedAt           DateTime?
  /// Set while paused; on resume the pause is added to `pausedMs` (ADR-028).
  pausedAt           DateTime?
  pausedMs           Int          @default(0)
  /// The projector's freeze cut, stored once when first seen frozen; pauses and extends never move it (audit R13-1).
  frozenAt           DateTime?
  /// SHA-256 of the projector link's token (ADR-028); the token itself is shown once.
  projectorTokenHash String?      @unique
  resultsState       ResultsState @default(NONE)
  /// When provisional results were published: the appeal window runs from here.
  provisionalAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  problems     Problem[]
  participants Participant[]
  tokenLedger  TokenLedger[]
  incidents    Incident[]
  judgeJobs    JudgeJob[]

  @@map("events")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
}

enum DraftKind {
  TEST
  NAIVE
}

enum DraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// GPT-OSS drafts for a problem (WP-07 task 8, R8-Q6): an edge/stress test input with its proposed output, or a naive
/// solution. Never shown to participants or judged; an admin approves one into a HIDDEN test or a NAIVE solution.
model ProblemDraft {
  id             String      @id @default(cuid())
  problemId      String
  problem        Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  kind           DraftKind
  status         DraftStatus @default(DRAFT)
  input          String?
  expectedOutput String?
  language       Language?
  source         String?
  note           String      @default("")
  model          String
  decidedAt      DateTime?
  decidedById    String?
  createdAt      DateTime    @default(now())

  @@index([problemId, status])
  @@map("problem_drafts")
}

model Problem {
  id            String     @id @default(cuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  /// Markdown statement shown to participants.
  statement     String
  difficulty    Difficulty
  ord           Int
  timeLimitMs   Int
  memoryLimitMb Int
  /// Checker (zod, @codehaunt/contracts).
  checker       Json
  /// Warm-up problem (ADR-007): open only before the contest starts; its tokens and score don't count.
  practice      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  testCases       TestCase[]
  chatSessions    ChatSession[]
  submissions     Submission[]
  solutions       ReferenceSolution[]
  calibrationRuns CalibrationRun[]
  drafts          ProblemDraft[]

  @@unique([eventId, slug])
  @@index([eventId, ord])
  @@map("problems")
}

enum TestVisibility {
  VISIBLE
  HIDDEN
}

/// HIDDEN rows are read only by the worker's judging path (engineering standards §2).
model TestCase {
  id             String         @id @default(cuid())
  problemId      String
  problem        Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  visibility     TestVisibility
  ord            Int
  input          String
  expectedOutput String

  @@unique([problemId, visibility, ord])
  @@map("test_cases")
}

enum SolutionKind {
  /// Must pass every test (calibration, ADR-005).
  REFERENCE
  /// Should fail on memory or time (ADR-018).
  NAIVE
}

/// Organizer-only solutions per language. Never returned by a participant-facing route.
model ReferenceSolution {
  id        String       @id @default(cuid())
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  Language
  kind      SolutionKind
  source    String
  updatedAt DateTime     @updatedAt

  @@unique([problemId, language, kind])
  @@map("reference_solutions")
}

/// "Calibrate" runs of a reference/naive solution against all tests (queued like submissions, ADR-025).
model CalibrationRun {
  id          String           @id @default(cuid())
  problemId   String
  problem     Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language    Language
  kind        SolutionKind
  source      String
  status      SubmissionStatus @default(QUEUED)
  attempts    Int              @default(0)
  requestedBy String
  /// RunResult (organizer-facing; may contain hidden-test output excerpts).
  result      Json?
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, createdAt])
  @@map("calibration_runs")
}

// ---------------------------------------------------------------------------
// Participants
// ---------------------------------------------------------------------------

enum ParticipantStatus {
  REGISTERED
  WAITLISTED
  CHECKED_IN
  DISQUALIFIED
}

/// A user's entry in one event. Seat is a label recorded at check-in.
model Participant {
  id               String            @id @default(cuid())
  eventId          String
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrolmentNo      String
  phone            String?
  status           ParticipantStatus @default(REGISTERED)
  /// SHA-256 of the single-use check-in QR token; cleared once used.
  checkInTokenHash String?           @unique
  checkedInAt      DateTime?
  seatLabel        String?
  /// Consent to logging and judging (ADR-010); required at registration.
  consentAt        DateTime?
  /// Optional, off by default: anonymised reuse of transcripts (R8-Q7).
  reuseConsent     Boolean           @default(false)
  /// Required only when the event allows minors (ADR-010).
  guardianConsent  Boolean           @default(false)
  /// Personal extra contest time: extensions and accommodation (ADR-028).
  extraMinutes     Int               @default(0)
  createdAt        DateTime          @default(now())

  chatSessions   ChatSession[]
  submissions    Submission[]
  tokenLedger    TokenLedger[]
  judgeReviews   JudgeReview[]
  scoreOverrides ScoreOverride[]
  incidents      Incident[]
  judgeJobs      JudgeJob[]

  @@unique([eventId, userId])
  @@unique([eventId, enrolmentNo])
  @@map("participants")
}

// ---------------------------------------------------------------------------
// Prompting
// ---------------------------------------------------------------------------

/// One model conversation (context window) of a participant on a problem.
model ChatSession {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  problemId     String
  problem       Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language      Language
  createdAt     DateTime    @default(now())
  /// Set when the participant resets the context; a new ChatSession starts.
  closedAt      DateTime?

  turns        PromptTurn[]
  codeVersions CodeVersion[]

  @@index([participantId, problemId])
  @@map("chat_sessions")
}

/// One prompt and the model's reply. Participant text and model output are untrusted.
model PromptTurn {
  id               String      @id @default(cuid())
  chatSessionId    String
  chatSession      ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  ord              Int
  idempotencyKey   String      @unique
  prompt           String
  reply            String?
  model            String
  node             String?
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  latencyMs        Int?
  createdAt        DateTime    @default(now())

  codeVersions CodeVersion[]
  tokenEntries TokenLedger[]

  @@unique([chatSessionId, ord])
  @@map("prompt_turns")
}

/// Code extracted from a model reply (participants cannot type code).
model CodeVersion {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  promptTurnId  String?
  promptTurn    PromptTurn? @relation(fields: [promptTurnId], references: [id], onDelete: SetNull)
  language      Language
  source        String
  createdAt     DateTime    @default(now())

  submissions Submission[]

  @@index([chatSessionId, createdAt])
  @@map("code_versions")
}

// ---------------------------------------------------------------------------
// Judging and scoring
// ---------------------------------------------------------------------------

enum SubmissionKind {
  SAMPLE
  SUBMIT
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Submission {
  id                 String           @id @default(cuid())
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  problemId          String
  problem            Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  codeVersionId      String
  codeVersion        CodeVersion      @relation(fields: [codeVersionId], references: [id], onDelete: Restrict)
  kind               SubmissionKind
  status             SubmissionStatus @default(QUEUED)
  idempotencyKey     String           @unique
  /// Claims by the worker (ADR-025): a row left RUNNING is requeued; after 2 attempts it is FAILED.
  attempts           Int              @default(0)
  /// Contest time elapsed when it was made, pauses excluded (ADR-028); scoring's decay uses it. Null for practice.
  contestMs          Int?
  /// The first IE's internalError: set means the run is (or was) the automatic re-check (ADR-021).
  firstInternalError String?
  createdAt          DateTime         @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?

  verdict   Verdict?
  incidents Incident[]

  @@index([participantId, problemId, createdAt])
  @@index([status, createdAt])
  @@map("submissions")
}

model Verdict {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// AC, WA, TLE, MLE, RE, CE, OLE, IE (contracts Verdict).
  verdict      String
  testsPassed  Int
  testsTotal   Int
  maxTimeMs    Int
  maxMemoryKb  Int
  compileLog   String
  /// Per-test RunTestResult[]. For SUBMIT this covers hidden tests: never return it raw to participants.
  results      Json
  createdAt    DateTime   @default(now())

  @@map("verdicts")
}

/// LLM process review (batch after the contest). Rationale and flags are organizer-facing.
model JudgeReview {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  problemId     String?
  rubricVersion String
  model         String
  score         Float
  rationale     String
  injectionFlag Boolean     @default(false)
  /// Schema-validated raw judge output.
  raw           Json
  createdAt     DateTime    @default(now())

  @@index([participantId])
  @@map("judge_reviews")
}

enum JudgeJobStatus {
  QUEUED
  RUNNING
  DONE
  NEEDS_MANUAL
}

/// One batch-judging run per participant and rubric version (WP-07, ADR-035): queued by staff after the contest,
/// worked by the one-shot `judge-review` container. NEEDS_MANUAL after the retries fail; staff score by override.
model JudgeJob {
  id            String         @id @default(cuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  rubricVersion String
  status        JudgeJobStatus @default(QUEUED)
  attempts      Int            @default(0)
  error         String?
  durationMs    Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@unique([participantId, rubricVersion])
  @@index([eventId, status])
  @@map("judge_jobs")
}

model ScoreOverride {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  problemId     String?
  component     String
  value         Float
  reason        String
  actorId       String
  createdAt     DateTime    @default(now())

  @@index([participantId])
  @@map("score_overrides")
}

enum IncidentKind {
  /// A submit was IE twice; the second counts as WA (ADR-021).
  JUDGE_IE
  /// docker-proxy refused a sandbox request during a run.
  PROXY_REFUSAL
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

/// Staff-facing (ADR-021, ADR-028). `detail` may hold participant-controlled text: render as plain text only.
model Incident {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId   String?
  participant     Participant?   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  submissionId    String?
  submission      Submission?    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind            IncidentKind
  status          IncidentStatus @default(OPEN)
  detail          Json
  /// Set by "reverse penalty": the submission no longer counts as a wrong attempt.
  penaltyReversed Boolean        @default(false)
  resolution      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@index([submissionId])
  @@index([eventId, createdAt])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Append-only ledgers (UPDATE/DELETE blocked by trigger)
// ---------------------------------------------------------------------------

enum TokenEntryKind {
  GRANT
  USAGE
  TOP_UP
  ADJUSTMENT
  /// Held before a model call (negative); settled by one RELEASE (ADR-022).
  RESERVE
  /// Returns the unused part of a RESERVE (all of it if the call failed).
  RELEASE
}

/// Token budget = SUM(delta) per participant. Usage rows are negative.
model TokenLedger {
  id             BigInt         @id @default(autoincrement())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participantId  String
  participant    Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  kind           TokenEntryKind
  delta          Int
  promptTurnId   String?
  promptTurn     PromptTurn?    @relation(fields: [promptTurnId], references: [id], onDelete: Restrict)
  actorId        String?
  reason         String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  @@index([participantId])
  @@map("token_ledger")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}
